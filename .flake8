[flake8]
max-line-length = 120
max-complexity = 10
exclude =
    .git,
    __pycache__,
    venv,
    .venv,
    dist,
    build,
    *.egg-info,
    .dvc,
    mlruns
ignore =
    W293,
    W291,
    W292,
    E302,
    E305,
    E402
per-file-ignores =
    tests/*: F401, E402
    app/schemas.py: F401